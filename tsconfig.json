{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@piano/base": ["packages/base/src/index.ts"],
      "@piano/dashboard": ["packages/dashboard/src/index.ts"],
      "@piano/logging": ["packages/logging/src/index.ts"],
      "@piano/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@piano/harness": ["packages/harness/src/index.ts"],
      "@piano/workers": ["packages/workers/src/index.ts"],
      "@piano/evals": ["packages/evals/src/index.ts"],
      "@piano/contract": ["packages/contract/src/index.ts"],
      "@piano/trajectory": ["packages/trajectory/src/index.ts"],
      "@piano/system-one": ["packages/system-one/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/server/**/*.mts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
