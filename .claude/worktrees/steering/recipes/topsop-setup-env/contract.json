{
  "version": 1,
  "id": "topsop-env-report",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "description": "topsop setup-env gate: routing, device/test_host, toolchain, build credentials (kds topsop_400.mdc item 11).",
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "ready",
          "blocked"
        ]
      },
      "target": {
        "type": "object",
        "properties": {
          "operator": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          },
          "dtype": {
            "type": "string"
          }
        },
        "required": [
          "dtype",
          "operator",
          "shape"
        ],
        "additionalProperties": false
      },
      "device": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          },
          "test_host": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "architecture",
          "name",
          "test_host"
        ],
        "additionalProperties": false
      },
      "toolchain": {
        "type": "object",
        "properties": {
          "compiler": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          },
          "profiler": {
            "type": "string"
          }
        },
        "required": [
          "compiler",
          "profiler",
          "runtime"
        ],
        "additionalProperties": false
      },
      "build": {
        "type": "object",
        "properties": {
          "so_path": {
            "type": "string",
            "minLength": 1
          },
          "so_mtime": {
            "type": "string"
          },
          "so_commit": {
            "type": "string"
          }
        },
        "required": [
          "so_path"
        ],
        "additionalProperties": false
      },
      "state_path": {
        "type": "string",
        "minLength": 1
      },
      "blocker": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "status",
      "target",
      "device",
      "toolchain"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "type": "object",
          "properties": {
            "status": {
              "const": "ready"
            }
          }
        },
        "then": {
          "not": {
            "type": "object",
            "required": [
              "blocker"
            ],
            "properties": {
              "blocker": {}
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "status": {
              "const": "blocked"
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "blocker"
          ],
          "properties": {
            "blocker": {}
          }
        }
      }
    ]
  },
  "example": {
    "status": "ready",
    "target": {
      "operator": "topssglAddAddRmsNorm",
      "shape": "[16384,2048]",
      "dtype": "bf16"
    },
    "device": {
      "name": "Enflame L600 DEV0",
      "architecture": "GCU400",
      "test_host": "wsj@10.12.115.153"
    },
    "toolchain": {
      "compiler": "ophal",
      "runtime": "topsop",
      "profiler": "topsprof"
    },
    "build": {
      "so_path": "build/lib/libkernel_normalize_sgl_add_add_rms_norm.so",
      "so_commit": "f5cc7d281b",
      "so_mtime": "2026-08-24 16:24:43 +0800"
    },
    "state_path": "state/tuning-state.json"
  },
  "outputs": {
    "metrics": [],
    "projections": [
      { "id": "workflow.status", "pointer": "/status", "format": "string", "required": true }
    ]
  }
}
