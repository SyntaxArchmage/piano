{
  "version": 1,
  "id": "topsop-v2-promotion-receipt",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "type": "object",
    "properties": {
      "protocol_version": {
        "const": 2
      },
      "status": {
        "enum": [
          "promoted",
          "restored",
          "terminal",
          "blocked"
        ]
      },
      "iteration": {
        "type": "integer",
        "minimum": 0
      },
      "source_ref": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "contract_id": {
                "const": "topsop-v2-candidate-evaluation"
              },
              "result_path": {
                "type": "string",
                "pattern": "^/",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "contract_id",
              "result_path",
              "sha256"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "contract_id": {
                "const": "topsop-v2-candidate-plan"
              },
              "result_path": {
                "type": "string",
                "pattern": "^/",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "contract_id",
              "result_path",
              "sha256"
            ],
            "additionalProperties": false
          }
        ]
      },
      "decision": {
        "enum": [
          "KEEP",
          "DISCARD",
          "CONVERGED",
          "BLOCKED"
        ]
      },
      "candidate_id": {
        "type": "string",
        "minLength": 1
      },
      "state": {
        "type": "object",
        "properties": {
          "namespace": {
            "const": "topsop-v2"
          },
          "previous_revision": {
            "type": "integer",
            "minimum": 0
          },
          "resulting_revision": {
            "type": "integer",
            "minimum": 0
          },
          "current_best": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "/topsop-v2/.*/artifacts/rev-[0-9]+/"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              },
              "workspace_diff_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256",
              "identity",
              "source_commit",
              "workspace_diff_digest"
            ],
            "additionalProperties": false
          },
          "state_path": {
            "type": "string",
            "pattern": "/topsop-v2/"
          },
          "state_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "state_schema_version": {
            "const": 1
          },
          "workspace_root": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          }
        },
        "required": [
          "namespace",
          "state_schema_version",
          "previous_revision",
          "resulting_revision",
          "current_best",
          "state_path",
          "state_sha256",
          "workspace_root"
        ],
        "additionalProperties": false
      },
      "git": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "committed",
              "restored",
              "unchanged"
            ]
          },
          "resulting_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "workspace_diff_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "verified": {
            "const": true
          }
        },
        "required": [
          "action",
          "resulting_commit",
          "workspace_diff_digest",
          "verified"
        ],
        "additionalProperties": false
      },
      "next_action": {
        "enum": [
          "continue",
          "stop"
        ]
      },
      "loop_control": {
        "enum": [
          "continue",
          "stop"
        ]
      },
      "failure": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "input",
              "workspace",
              "source",
              "build",
              "device",
              "correctness",
              "performance",
              "state",
              "internal"
            ]
          },
          "scope": {
            "enum": [
              "candidate",
              "iteration",
              "run"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "scope",
          "retryable",
          "code",
          "message",
          "next_action"
        ],
        "additionalProperties": false
      },
      "block_scope": {
        "const": "global"
      },
      "target_validation_ref": {
        "type": "object",
        "properties": {
          "result_path": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "json_pointer": {
            "const": "/target_validation"
          }
        },
        "required": [
          "result_path",
          "sha256",
          "json_pointer"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "protocol_version",
      "status",
      "iteration",
      "source_ref",
      "decision",
      "next_action",
      "loop_control"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "promoted"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "state",
            "git",
            "target_validation_ref"
          ],
          "properties": {
            "state": {},
            "git": {},
            "decision": {
              "const": "KEEP"
            },
            "next_action": {
              "const": "continue"
            },
            "loop_control": {
              "const": "continue"
            },
            "target_validation_ref": {}
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "restored"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "state",
            "git"
          ],
          "properties": {
            "state": {},
            "git": {},
            "decision": {
              "const": "DISCARD"
            },
            "next_action": {
              "const": "continue"
            },
            "loop_control": {
              "const": "continue"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "terminal"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "state",
            "git"
          ],
          "properties": {
            "state": {},
            "git": {},
            "decision": {
              "const": "CONVERGED"
            },
            "next_action": {
              "const": "stop"
            },
            "loop_control": {
              "const": "stop"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "blocked"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "failure",
            "block_scope"
          ],
          "properties": {
            "failure": {},
            "block_scope": {},
            "decision": {
              "const": "BLOCKED"
            },
            "next_action": {
              "const": "stop"
            },
            "loop_control": {
              "const": "continue"
            }
          }
        }
      }
    ]
  },
  "example": {
    "protocol_version": 2,
    "status": "promoted",
    "iteration": 0,
    "source_ref": {
      "contract_id": "topsop-v2-candidate-evaluation",
      "result_path": "/tmp/run/evaluate/result.json",
      "sha256": "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    },
    "decision": "KEEP",
    "candidate_id": "iter0-double-buffer",
    "target_validation_ref": {
      "result_path": "/tmp/run/evaluate/result.json",
      "sha256": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
      "json_pointer": "/target_validation"
    },
    "state": {
      "namespace": "topsop-v2",
      "previous_revision": 0,
      "resulting_revision": 1,
      "current_best": {
        "path": "/tmp/.piano/state/topsop-v2/repo/example-op/workload/artifacts/rev-1/libkernel_example.so",
        "sha256": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "identity": "candidate:iter0-double-buffer",
        "source_commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "workspace_diff_digest": "sha256:8888888888888888888888888888888888888888888888888888888888888888"
      },
      "state_path": "/tmp/.piano/state/topsop-v2/repo/example-op/workload/state.json",
      "state_sha256": "sha256:7777777777777777777777777777777777777777777777777777777777777777",
      "state_schema_version": 1,
      "workspace_root": "/tmp/topsop"
    },
    "git": {
      "action": "committed",
      "resulting_commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "workspace_diff_digest": "sha256:8888888888888888888888888888888888888888888888888888888888888888",
      "verified": true
    },
    "next_action": "continue",
    "loop_control": "continue"
  },
  "outputs": {
    "metrics": [],
    "projections": [
      {
        "id": "workflow.status",
        "pointer": "/status",
        "format": "string",
        "required": true
      },
      {
        "id": "workflow.loop-control",
        "pointer": "/loop_control",
        "format": "string",
        "required": true
      }
    ]
  }
}
