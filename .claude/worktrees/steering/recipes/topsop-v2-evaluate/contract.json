{
 "version": 1,
 "id": "topsop-v2-candidate-evaluation",
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-piano-unknown-properties": "strip",
  "type": "object",
  "properties": {
   "protocol_version": {
    "const": 2
   },
   "status": {
    "enum": [
     "measured",
     "rejected",
     "skipped",
     "blocked"
    ]
   },
   "candidate_ref": {
    "type": "object",
    "properties": {
     "contract_id": {
      "const": "topsop-v2-candidate-artifact"
     },
     "result_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     }
    },
    "required": [
     "contract_id",
     "result_path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "candidate_id": {
    "type": "string",
    "minLength": 1
   },
   "correctness": {
    "type": "object",
    "properties": {
     "all_passed": {
      "const": true
     },
     "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "workload_id": {
         "type": "string",
         "minLength": 1
        },
        "role": {
         "enum": [
          "primary",
          "guard"
         ]
        },
        "target_case": {
         "type": "string",
         "minLength": 1
        },
        "runtime_identity_matched": {
         "const": true
        },
        "passed": {
         "const": true
        },
        "evidence_ref": {
         "type": "object",
         "properties": {
          "path": {
           "type": "string",
           "pattern": "^/",
           "minLength": 1
          },
          "sha256": {
           "type": "string",
           "pattern": "^sha256:[0-9a-f]{64}$"
          }
         },
         "required": [
          "path",
          "sha256"
         ],
         "additionalProperties": false
        }
       },
       "required": [
        "workload_id",
        "role",
        "target_case",
        "runtime_identity_matched",
        "passed",
        "evidence_ref"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "all_passed",
     "cases"
    ],
    "additionalProperties": false
   },
   "benchmark": {
    "type": "object",
    "properties": {
     "name": {
      "const": "kernel_latency_us"
     },
     "unit": {
      "const": "us"
     },
     "direction": {
      "const": "lower"
     },
     "median": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "samples": {
      "type": "array",
      "minItems": 3,
      "items": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "raw_samples_ref": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^/",
        "minLength": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       }
      },
      "required": [
       "path",
       "sha256"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "name",
     "unit",
     "direction",
     "median",
     "samples",
     "raw_samples_ref"
    ],
    "additionalProperties": false
   },
   "comparison": {
    "type": "object",
    "properties": {
     "candidate_median": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "signed_improvement": {
      "type": "number"
     },
     "relative_improvement": {
      "type": "number"
     },
     "minimum_improvement": {
      "type": "number",
      "minimum": 0
     },
     "eligible": {
      "type": "boolean"
     },
     "reason": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "candidate_median",
     "signed_improvement",
     "relative_improvement",
     "minimum_improvement",
     "eligible",
     "reason"
    ],
    "additionalProperties": false
   },
   "failure": {
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "input",
       "workspace",
       "source",
       "build",
       "device",
       "correctness",
       "performance",
       "state",
       "internal"
      ]
     },
     "scope": {
      "enum": [
       "candidate",
       "iteration",
       "run"
      ]
     },
     "retryable": {
      "type": "boolean"
     },
     "code": {
      "type": "string",
      "minLength": 1
     },
     "message": {
      "type": "string",
      "minLength": 1
     },
     "next_action": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "kind",
     "scope",
     "retryable",
     "code",
     "message",
     "next_action"
    ],
    "additionalProperties": false
   },
   "block_scope": {
    "enum": [
     "iteration",
     "global"
    ]
   },
   "rejection": {
    "type": "object",
    "properties": {
     "reason": {
      "type": "string",
      "minLength": 1
     },
     "evidence_refs": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^/",
         "minLength": 1
        },
        "sha256": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       },
       "required": [
        "path",
        "sha256"
       ],
       "additionalProperties": false
      }
     },
     "restore_required": {
      "type": "boolean"
     }
    },
    "required": [
     "reason",
     "evidence_refs",
     "restore_required"
    ],
    "additionalProperties": false
   },
   "skip_reason": {
    "type": "string",
    "minLength": 1
   },
   "referee": {
    "type": "object",
    "properties": {
     "name": {
      "const": "kernel_latency_median_us"
     },
     "unit": {
      "const": "us"
     },
     "direction": {
      "const": "lower"
     },
     "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     },
     "best": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "median": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "runs": {
      "const": 1
     },
     "warmup": {
      "const": 0
     },
     "raw_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     }
    },
    "required": [
     "name",
     "unit",
     "direction",
     "samples",
     "best",
     "median",
     "runs",
     "warmup",
     "raw_path"
    ],
    "additionalProperties": false
   },
   "target_validation": {
    "type": "object",
    "properties": {
     "candidate_artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "runtime_identity_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "targets_declared": {
      "type": "boolean"
     },
     "all_declared_targets_observed": {
      "const": true
     },
     "measurements": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "metric": {
         "type": "string",
         "minLength": 1
        },
        "operator": {
         "enum": [
          ">=",
          "<="
         ]
        },
        "target_value": {
         "type": "number"
        },
        "observed_value": {
         "type": "number"
        },
        "met": {
         "type": "boolean"
        },
        "evidence_ref": {
         "type": "object",
         "properties": {
          "path": {
           "type": "string",
           "pattern": "^/",
           "minLength": 1
          },
          "sha256": {
           "type": "string",
           "pattern": "^sha256:[0-9a-f]{64}$"
          }
         },
         "required": [
          "path",
          "sha256"
         ],
         "additionalProperties": false
        }
       },
       "required": [
        "metric",
        "operator",
        "target_value",
        "observed_value",
        "met",
        "evidence_ref"
       ],
       "additionalProperties": false
      }
     },
     "profile_ref": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^/",
        "minLength": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       }
      },
      "required": [
       "path",
       "sha256"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "candidate_artifact_sha256",
     "runtime_identity_sha256",
     "targets_declared",
     "all_declared_targets_observed",
     "measurements"
    ],
    "additionalProperties": false,
    "allOf": [
     {
      "if": {
       "properties": {
        "targets_declared": {
         "const": true
        }
       },
       "required": [
        "targets_declared"
       ]
      },
      "then": {
       "required": [
        "profile_ref"
       ],
       "properties": {
        "measurements": {
         "minItems": 1,
         "type": "array"
        },
        "profile_ref": {}
       }
      }
     },
     {
      "if": {
       "properties": {
        "targets_declared": {
         "const": false
        }
       },
       "required": [
        "targets_declared"
       ]
      },
      "then": {
       "properties": {
        "measurements": {
         "maxItems": 0,
         "type": "array"
        }
       },
       "not": {
        "required": [
         "profile_ref"
        ]
       }
      }
     }
    ]
   },
   "comparison_base": {
    "$ref": "#/$defs/comparisonBase"
   }
  },
  "required": [
   "protocol_version",
   "status",
   "candidate_ref",
   "candidate_id"
  ],
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "status": {
       "const": "measured"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "correctness",
      "benchmark",
      "comparison_base",
      "comparison"
     ],
     "properties": {
      "correctness": {},
      "benchmark": {},
      "comparison": {},
      "comparison_base": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "measured"
      },
      "comparison": {
       "type": "object",
       "properties": {
        "eligible": {
         "const": true
        }
       },
       "required": [
        "eligible"
       ]
      }
     },
     "required": [
      "status",
      "comparison"
     ]
    },
    "then": {
     "required": [
      "target_validation"
     ],
     "properties": {
      "target_validation": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "rejected"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "rejection"
     ],
     "properties": {
      "rejection": {}
     },
     "not": {
      "anyOf": [
       {
        "required": [
         "correctness"
        ]
       },
       {
        "required": [
         "benchmark"
        ]
       },
       {
        "required": [
         "comparison"
        ]
       },
       {
        "required": [
         "referee"
        ],
        "properties": {
         "referee": {}
        }
       },
       {
        "required": [
         "target_validation"
        ],
        "properties": {
         "target_validation": {}
        }
       }
      ]
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "skipped"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "skip_reason"
     ],
     "properties": {
      "skip_reason": {}
     },
     "not": {
      "anyOf": [
       {
        "required": [
         "correctness"
        ]
       },
       {
        "required": [
         "benchmark"
        ]
       },
       {
        "required": [
         "comparison"
        ]
       },
       {
        "required": [
         "referee"
        ],
        "properties": {
         "referee": {}
        }
       },
       {
        "required": [
         "target_validation"
        ],
        "properties": {
         "target_validation": {}
        }
       }
      ]
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "blocked"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "failure",
      "block_scope"
     ],
     "properties": {
      "failure": {},
      "block_scope": {}
     }
    }
   },
   {"if":{"properties":{"status":{"const":"blocked"},"failure":{"type":"object","properties":{"code":{"const":"executor_unavailable"}},"required":["code"]}},"required":["status","failure"]},"then":{"properties":{"failure":{"properties":{"kind":{"const":"internal"},"scope":{"const":"iteration"},"retryable":{"const":true}},"type":"object"},"block_scope":{"const":"iteration"}}}}
  ],
  "$defs": {
   "comparisonBase": {"type":"object","properties":{"state_revision":{"type":"integer","minimum":0},"artifact_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"artifact_identity":{"type":"string","minLength":1},"metric_median":{"type":"number","exclusiveMinimum":0}},"required":["state_revision","artifact_sha256","artifact_identity","metric_median"],"additionalProperties":false}
  }
 },
 "example": {
  "protocol_version": 2,
  "status": "measured",
  "candidate_ref": {
   "contract_id": "topsop-v2-candidate-artifact",
