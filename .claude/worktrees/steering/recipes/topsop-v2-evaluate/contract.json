  },
  "target_validation": {"candidate_artifact_sha256":"sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff","runtime_identity_sha256":"sha256:1111111111111111111111111111111111111111111111111111111111111111","targets_declared":true,"all_declared_targets_observed":true,"measurements":[{"metric":"llc_rw_sum_gbps","operator":">=","target_value":2000,"observed_value":2100,"met":true,"evidence_ref":{"path":"/tmp/target.json","sha256":"sha256:7777777777777777777777777777777777777777777777777777777777777777"}}],"profile_ref":{"path":"/tmp/target.json","sha256":"sha256:7777777777777777777777777777777777777777777777777777777777777777"}},
  "comparison_base": {"state_revision":0,"artifact_sha256":"sha256:2222222222222222222222222222222222222222222222222222222222222222","artifact_identity":"baseline:example","metric_median":10.0},
  "referee": {"name":"kernel_latency_median_us","unit":"us","direction":"lower","samples":[9.5],"best":9.5,"median":9.5,"runs":1,"warmup":0,"raw_path":"/s"}
 },
 "outputs": {
  "metrics": [
   {
