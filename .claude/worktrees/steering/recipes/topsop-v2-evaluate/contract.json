   "sha256": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
  },
  "candidate_id": "iter0-double-buffer",
  "correctness": {"all_passed":true,"cases":[{"workload_id":"main","role":"primary","target_case":"example.case","runtime_identity_matched":true,"passed":true,"evidence_ref":{"path":"/tmp/evidence/verify.log","sha256":"sha256:4444444444444444444444444444444444444444444444444444444444444444"}}]},
  "benchmark": {
