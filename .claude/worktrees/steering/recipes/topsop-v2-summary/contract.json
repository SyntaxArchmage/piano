{
 "version": 1,
 "id": "topsop-v2-final-summary",
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-piano-unknown-properties": "strip",
  "type": "object",
  "properties": {
   "protocol_version": {
    "const": 2
   },
   "status": {
    "const": "completed"
   },
   "outcome": {
    "enum": [
     "improved",
     "no_improvement",
     "blocked",
     "interrupted"
    ]
   },
   "baseline_ref": {
    "type": "object",
    "properties": {
     "contract_id": {
      "const": "topsop-v2-baseline-bundle"
     },
     "result_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     }
    },
    "required": [
     "contract_id",
     "result_path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "final_promotion_ref": {
    "type": "object",
    "properties": {
     "contract_id": {
      "const": "topsop-v2-promotion-receipt"
     },
     "result_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     }
    },
    "required": [
     "contract_id",
     "result_path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "workload_fingerprint": {
    "type": "string",
    "pattern": "^sha256:[0-9a-f]{64}$"
   },
   "rounds": {
    "type": "object",
    "properties": {
     "scheduled": {
      "type": "integer",
      "minimum": 0
     },
     "attempted": {
      "type": "integer",
      "minimum": 0
     },
     "measured": {
      "type": "integer",
      "minimum": 0
     },
     "target_measured": {
      "const": 10
     },
     "replans": {
      "type": "integer",
      "minimum": 0
     },
     "kept": {
      "type": "integer",
      "minimum": 0
     },
     "discarded": {
      "type": "integer",
      "minimum": 0
     },
     "failed": {
      "type": "integer",
      "minimum": 0
     }
    },
    "required": [
     "scheduled",
     "attempted",
     "measured",
     "target_measured",
     "replans",
     "kept",
     "discarded",
     "failed"
    ],
    "additionalProperties": false
   },
   "baseline_metric": {
    "type": "object",
    "properties": {
     "name": {
      "const": "kernel_latency_us"
     },
     "unit": {
      "const": "us"
     },
     "direction": {
      "const": "lower"
     },
     "median": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "required": [
     "name",
     "unit",
     "direction",
     "median"
    ],
    "additionalProperties": false
   },
   "final_metric": {
    "type": "object",
    "properties": {
     "name": {
      "const": "kernel_latency_us"
     },
     "unit": {
      "const": "us"
     },
     "direction": {
      "const": "lower"
     },
     "median": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "required": [
     "name",
     "unit",
     "direction",
     "median"
    ],
    "additionalProperties": false
   },
   "final_artifact": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "identity": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "path",
     "sha256",
     "identity"
    ],
    "additionalProperties": false
   },
   "state": {
    "type": "object",
    "properties": {
     "namespace": {
      "const": "topsop-v2"
     },
     "revision": {
      "type": "integer",
      "minimum": 0
     },
     "state_path": {
      "type": "string",
      "pattern": "/topsop-v2/"
     },
     "verified": {
      "type": "boolean"
     },
     "startup_mode": {
      "enum": [
       "initialized",
       "continued"
      ]
     },
     "state_schema_version": {
      "const": 1
     }
    },
    "required": [
     "namespace",
     "state_schema_version",
     "startup_mode",
     "revision",
     "state_path",
     "verified"
    ],
    "additionalProperties": false
   },
   "upstream_failure": {
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "input",
       "workspace",
       "source",
       "build",
       "device",
       "correctness",
       "performance",
       "state",
       "internal"
      ]
     },
     "scope": {
      "enum": [
       "candidate",
       "iteration",
       "run"
      ]
     },
     "retryable": {
      "type": "boolean"
     },
     "code": {
      "type": "string",
      "minLength": 1
     },
     "message": {
      "type": "string",
      "minLength": 1
     },
     "next_action": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "kind",
     "scope",
     "retryable",
     "code",
     "message",
     "next_action"
    ],
    "additionalProperties": false
   },
   "cleanup": {
    "type": "object",
    "properties": {
     "lease_release_attempted": {
      "type": "boolean"
     },
     "lease_released": {
      "type": "boolean"
     },
     "workspace_restored": {
      "type": "boolean"
     },
     "issues": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "lease_release_attempted",
     "lease_released",
     "workspace_restored",
     "issues"
    ],
    "additionalProperties": false
   },
   "next_action": {
    "type": "string",
    "minLength": 1
   },
   "final_target_validation": {
    "type": "object",
    "properties": {
     "candidate_id": {
      "type": "string",
      "minLength": 1
     },
     "candidate_artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "runtime_identity_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "targets_declared": {
      "type": "boolean"
     },
     "all_declared_targets_observed": {
      "const": true
     },
     "measurements": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "metric": {
         "type": "string",
         "minLength": 1
        },
        "operator": {
         "enum": [
          ">=",
          "<="
         ]
        },
        "target_value": {
         "type": "number"
        },
        "observed_value": {
         "type": "number"
        },
        "met": {
         "type": "boolean"
        },
        "evidence_ref": {
         "type": "object",
         "properties": {
          "path": {
           "type": "string",
           "pattern": "^/",
           "minLength": 1
          },
          "sha256": {
           "type": "string",
           "pattern": "^sha256:[0-9a-f]{64}$"
          }
         },
         "required": [
          "path",
          "sha256"
         ],
         "additionalProperties": false
        }
       },
       "required": [
        "metric",
        "operator",
        "target_value",
        "observed_value",
        "met",
        "evidence_ref"
       ],
       "additionalProperties": false
      }
     },
     "profile_ref": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^/",
        "minLength": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       }
      },
      "required": [
       "path",
       "sha256"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "candidate_id",
     "candidate_artifact_sha256",
     "runtime_identity_sha256",
     "targets_declared",
     "all_declared_targets_observed",
     "measurements"
    ],
    "additionalProperties": false,
    "allOf": [
     {
      "if": {
       "properties": {
        "targets_declared": {
         "const": true
        }
       },
       "required": [
        "targets_declared"
       ]
      },
      "then": {
       "required": [
        "profile_ref"
       ],
       "properties": {
        "measurements": {
         "minItems": 1,
         "type": "array"
        },
        "profile_ref": {}
       }
      }
     },
     {
      "if": {
       "properties": {
        "targets_declared": {
         "const": false
        }
       },
       "required": [
        "targets_declared"
       ]
      },
      "then": {
       "properties": {
        "measurements": {
         "maxItems": 0,
         "type": "array"
        }
       },
       "not": {
        "required": [
         "profile_ref"
        ]
       }
      }
     }
    ]
   }
  },
  "required": [
   "protocol_version",
   "status",
   "outcome",
   "rounds",
   "cleanup",
   "next_action"
  ],
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "outcome": {
       "enum": [
        "improved",
        "no_improvement"
       ]
      }
     },
     "required": [
      "outcome"
     ]
    },
    "then": {
     "required": [
      "baseline_ref",
      "workload_fingerprint",
      "baseline_metric",
      "final_metric",
      "final_artifact",
      "state"
     ],
     "properties": {
      "baseline_ref": {},
      "workload_fingerprint": {},
      "baseline_metric": {},
      "final_metric": {},
      "final_artifact": {},
      "state": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "outcome": {
       "enum": [
        "blocked",
        "interrupted"
       ]
      }
     },
     "required": [
      "outcome"
     ]
    },
    "then": {
     "required": [
      "upstream_failure"
     ],
     "properties": {
      "upstream_failure": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "outcome": {
       "const": "improved"
      }
     },
     "required": [
      "outcome"
     ]
    },
    "then": {
     "required": [
      "final_target_validation"
     ],
     "properties": {
      "final_target_validation": {}
     }
    }
   }
  ]
 },
 "example": {
  "protocol_version": 2,
  "status": "completed",
  "outcome": "improved",
  "baseline_ref": {
   "contract_id": "topsop-v2-baseline-bundle",
   "result_path": "/tmp/run/characterize/result.json",
   "sha256": "sha256:9999999999999999999999999999999999999999999999999999999999999999"
  },
  "final_promotion_ref": {
   "contract_id": "topsop-v2-promotion-receipt",
   "result_path": "/tmp/run/promote/result.json",
   "sha256": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "workload_fingerprint": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
  "rounds": {
   "scheduled": 1,
   "attempted": 1,
   "measured": 1,
   "target_measured": 10,
   "replans": 0,
   "kept": 1,
   "discarded": 0,
   "failed": 0
  },
  "baseline_metric": {
   "name": "kernel_latency_us",
   "unit": "us",
   "direction": "lower",
   "median": 10.0
  },
  "final_metric": {
   "name": "kernel_latency_us",
   "unit": "us",
   "direction": "lower",
   "median": 9.5
  },
  "final_target_validation": {
   "candidate_id": "iter0-double-buffer",
   "candidate_artifact_sha256": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
   "runtime_identity_sha256": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
   "targets_declared": true,
   "all_declared_targets_observed": true,
   "measurements": [
    {
     "metric": "llc_rw_sum_gbps",
     "operator": ">=",
     "target_value": 2000,
     "observed_value": 2100,
     "met": true,
     "evidence_ref": {
      "path": "/tmp/evidence/candidate-target-profile.json",
      "sha256": "sha256:7777777777777777777777777777777777777777777777777777777777777777"
     }
    }
   ],
   "profile_ref": {
    "path": "/tmp/evidence/candidate-target-profile.json",
    "sha256": "sha256:7777777777777777777777777777777777777777777777777777777777777777"
   }
  },
  "final_artifact": {
   "path": "/tmp/build/lib/libkernel_example.so",
   "sha256": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
