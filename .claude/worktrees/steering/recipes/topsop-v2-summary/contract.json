  "next_action": "continue only if the declared target is still unmet"
 },
 "outputs": {
  "metrics": [],
  "projections": [
   {
    "id": "workflow.status",
    "pointer": "/status",
    "format": "string",
    "required": true
   },
   {
    "id": "summary.outcome",
    "pointer": "/outcome",
    "format": "string",
    "required": true
   }
  ]
 }
}
