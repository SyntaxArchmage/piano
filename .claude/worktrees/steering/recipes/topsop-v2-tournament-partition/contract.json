{
  "version": 1,
  "id": "topsop-v2-tournament-lane-plan",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "type": "object",
    "properties": {
      "protocol_version": {
        "const": 2
      },
      "status": {
        "enum": [
          "ready",
          "blocked"
        ]
      },
      "iteration": {
        "type": "integer",
        "minimum": 0
      },
      "base_state_revision": {
        "type": "integer",
        "minimum": 0
      },
      "lanes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "lane_id": {
              "type": "string",
              "pattern": "^lane-[0-2]$"
            },
            "focus_categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "data_movement_overlap",
                  "tiling_partitioning",
                  "storage_layout",
                  "compute_codegen",
                  "launch_specialization",
                  "fusion_algorithm"
                ]
              }
            },
            "mandate": {
              "type": "string",
              "minLength": 1
            },
            "avoid_mechanisms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "lane_id",
            "focus_categories",
            "mandate",
            "avoid_mechanisms",
            "evidence_refs"
          ],
          "additionalProperties": false
        }
      },
      "failure": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "input",
              "workspace",
              "source",
              "build",
              "device",
              "correctness",
              "performance",
              "state",
              "internal"
            ]
          },
          "scope": {
            "enum": [
              "candidate",
              "iteration",
              "run"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "scope",
          "retryable",
          "code",
          "message",
          "next_action"
        ],
        "additionalProperties": false
      },
      "block_scope": {
        "const": "global"
      }
    },
    "required": [
      "protocol_version",
      "status",
      "iteration",
      "base_state_revision",
      "lanes"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "ready"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "lanes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "blocked"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "failure",
            "block_scope"
          ],
          "properties": {
            "lanes": {
              "type": "array",
              "maxItems": 0
            },
            "failure": {},
            "block_scope": {}
          }
        }
      }
    ]
  },
  "example": {
    "protocol_version": 2,
    "status": "ready",
    "iteration": 0,
    "base_state_revision": 0,
    "lanes": [
      {
        "lane_id": "lane-0",
        "focus_categories": [
          "data_movement_overlap",
          "storage_layout"
        ],
        "mandate": "Prioritize reducing exposed DTE and LLC traffic while preserving the frozen workload.",
        "avoid_mechanisms": [],
        "evidence_refs": [
          {
            "path": "/tmp/evidence/partition.json",
            "sha256": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          }
        ]
      },
      {
        "lane_id": "lane-1",
        "focus_categories": [
          "tiling_partitioning",
          "launch_specialization"
        ],
        "mandate": "Prioritize tile geometry, partitioning, residency, and launch topology.",
        "avoid_mechanisms": [],
        "evidence_refs": [
          {
            "path": "/tmp/evidence/partition.json",
            "sha256": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          }
        ]
      },
      {
        "lane_id": "lane-2",
        "focus_categories": [
          "compute_codegen",
          "fusion_algorithm"
        ],
        "mandate": "Prioritize compute scheduling, code generation, and algorithmic restructuring.",
        "avoid_mechanisms": [],
        "evidence_refs": [
          {
            "path": "/tmp/evidence/partition.json",
            "sha256": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
          }
        ]
      }
    ]
  },
  "outputs": {
    "metrics": [],
    "projections": [
      {
        "id": "workflow.map-items",
        "pointer": "/lanes",
        "format": "json",
        "required": true
      },
      {
        "id": "workflow.status",
        "pointer": "/status",
        "format": "string",
        "required": true
      },
      {
        "id": "workflow.block-scope",
        "pointer": "/block_scope",
        "format": "string",
        "required": false
      }
    ]
  }
}
