{
  "version": 1,
  "id": "summary-worker",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["demo_stage", "purpose", "primitive", "observed", "conclusion"],
    "properties": {
      "demo_stage": { "type": "string", "minLength": 1 },
      "purpose": { "type": "string", "minLength": 1 },
      "primitive": { "type": "string", "minLength": 1 },
      "observed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "conclusion": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "example": {
    "demo_stage": "finish",
    "purpose": "explain the completed demonstration",
    "primitive": "fan-in summary",
    "observed": ["accepted handoffs flowed through dependencies", "two tournament items produced two lane results"],
    "conclusion": "the workflow primitives were observable without changing the project"
  }
}
