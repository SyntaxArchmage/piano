{
 "version": 1,
 "id": "topsop-v2-candidate-plan",
 "schema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-piano-unknown-properties": "strip",
  "type": "object",
  "properties": {
   "protocol_version": {
    "const": 2
   },
   "status": {
    "enum": [
     "candidate",
     "converged",
     "blocked"
    ]
   },
   "iteration": {
    "type": "integer",
    "minimum": 0
   },
   "baseline_ref": {
    "type": "object",
    "properties": {
     "contract_id": {
      "const": "topsop-v2-baseline-bundle"
     },
     "result_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     }
    },
    "required": [
     "contract_id",
     "result_path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "previous_promotion_ref": {
    "type": "object",
    "properties": {
     "contract_id": {
      "const": "topsop-v2-promotion-receipt"
     },
     "result_path": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     }
    },
    "required": [
     "contract_id",
     "result_path",
     "sha256"
    ],
    "additionalProperties": false
   },
   "candidate": {
    "type": "object",
    "properties": {
     "candidate_id": {
      "type": "string",
      "minLength": 1
     },
     "base_artifact": {
      "type": "object",
      "properties": {
       "path": {
        "type": "string",
        "pattern": "^/",
        "minLength": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
       },
       "identity": {
        "type": "string",
        "minLength": 1
       }
      },
      "required": [
       "path",
       "sha256",
       "identity"
      ],
      "additionalProperties": false
     },
     "base_state_revision": {
      "type": "integer",
      "minimum": 0
     },
     "mechanism": {
      "type": "string",
      "minLength": 1
     },
     "variable": {
      "type": "string",
      "minLength": 1
     },
     "variable_type": {
      "enum": [
       "structural",
       "config"
      ]
     },
     "hypothesis": {
      "type": "string",
      "minLength": 1
     },
     "edit_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "expected_effect": {
      "type": "string",
      "minLength": 1
     },
     "risk": {
      "enum": [
       "low",
       "medium",
       "high"
      ]
     },
     "falsification_criterion": {
      "type": "string",
      "minLength": 1
     },
     "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^/",
         "minLength": 1
        },
        "sha256": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       },
       "required": [
        "path",
        "sha256"
       ],
       "additionalProperties": false
      }
     },
     "category": {
      "enum": [
       "data_movement_overlap",
       "tiling_partitioning",
       "storage_layout",
       "compute_codegen",
       "launch_specialization",
       "fusion_algorithm"
      ]
     },
     "implementation_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "constraint_id": {
         "type": "string",
         "minLength": 1
        },
        "kind": {
         "enum": [
          "resource_budget",
          "runtime_semantics",
          "memory_layout",
          "launch_geometry",
          "instruction_contract",
          "other"
         ]
        },
        "claim": {
         "type": "string",
         "minLength": 1
        },
        "expected": {
         "type": "string",
         "minLength": 1
        },
        "evidence_refs": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "properties": {
           "path": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
           },
           "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
           }
          },
          "required": [
           "path",
           "sha256"
          ],
          "additionalProperties": false
         }
        }
       },
       "required": [
        "constraint_id",
        "kind",
        "claim",
        "expected",
        "evidence_refs"
       ],
       "additionalProperties": false
      }
     },
     "comparison_base": {
      "$ref": "#/$defs/comparisonBase"
     }
    },
    "required": [
     "candidate_id",
     "base_artifact",
     "base_state_revision",
     "category",
     "mechanism",
     "variable",
     "variable_type",
     "hypothesis",
     "edit_scope",
     "expected_effect",
     "risk",
     "implementation_constraints",
     "falsification_criterion",
     "evidence_refs",
     "comparison_base"
    ],
    "additionalProperties": false
   },
   "convergence": {
    "type": "object",
    "properties": {
     "reason": {
      "type": "string",
      "minLength": 1
     },
     "exhausted_mechanisms": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "evidence_refs": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^/",
         "minLength": 1
        },
        "sha256": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       },
       "required": [
        "path",
        "sha256"
       ],
       "additionalProperties": false
      }
     },
     "replan_performed": {
      "const": true
     },
     "unresolved_target_gap": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "reason",
     "exhausted_mechanisms",
     "evidence_refs",
     "replan_performed",
     "unresolved_target_gap"
    ],
    "additionalProperties": false
   },
   "failure": {
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "input",
       "workspace",
       "source",
       "build",
       "device",
       "correctness",
       "performance",
       "state",
       "internal"
      ]
     },
     "scope": {
      "enum": [
       "candidate",
       "iteration",
       "run"
      ]
     },
     "retryable": {
      "type": "boolean"
     },
     "code": {
      "type": "string",
      "minLength": 1
     },
     "message": {
      "type": "string",
      "minLength": 1
     },
     "next_action": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "kind",
     "scope",
     "retryable",
     "code",
     "message",
     "next_action"
    ],
    "additionalProperties": false
   },
   "block_scope": {
    "enum": [
     "iteration",
     "global"
    ]
   },
   "search_progress": {
    "type": "object",
    "properties": {
     "target_experiments": {
      "const": 10
     },
     "measured_experiments": {
      "type": "integer",
      "minimum": 0
     },
     "replan_generation": {
      "type": "integer",
      "minimum": 0
     },
     "mode": {
      "enum": [
       "focused",
       "expanded",
       "structural"
      ]
     },
     "category_coverage": {
      "type": "object",
      "properties": {
       "data_movement_overlap": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       },
       "tiling_partitioning": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       },
       "storage_layout": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       },
       "compute_codegen": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       },
       "launch_specialization": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       },
       "fusion_algorithm": {
        "enum": [
         "untried",
         "active",
         "tested",
         "exhausted",
         "infeasible"
        ]
       }
      },
      "required": [
       "data_movement_overlap",
       "tiling_partitioning",
       "storage_layout",
       "compute_codegen",
       "launch_specialization",
       "fusion_algorithm"
      ],
      "additionalProperties": false
     },
     "evidence_refs": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "path": {
         "type": "string",
         "pattern": "^/",
         "minLength": 1
        },
        "sha256": {
         "type": "string",
         "pattern": "^sha256:[0-9a-f]{64}$"
        }
       },
       "required": [
        "path",
        "sha256"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "target_experiments",
     "measured_experiments",
     "replan_generation",
     "mode",
     "category_coverage",
     "evidence_refs"
    ],
    "additionalProperties": false
   }
  },
  "required": [
   "protocol_version",
   "status",
   "iteration",
   "baseline_ref"
  ],
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "status": {
       "const": "candidate"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "candidate",
      "search_progress"
     ],
     "properties": {
      "candidate": {},
      "search_progress": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "converged"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "convergence",
      "search_progress"
     ],
     "properties": {
      "convergence": {},
      "search_progress": {
       "properties": {
        "mode": {
         "const": "structural"
        },
        "category_coverage": {
         "properties": {
          "data_movement_overlap": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          },
          "tiling_partitioning": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          },
          "storage_layout": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          },
          "compute_codegen": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          },
          "launch_specialization": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          },
          "fusion_algorithm": {
           "enum": [
            "exhausted",
            "infeasible"
           ]
          }
         },
         "type": "object"
        }
       },
       "type": "object"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "blocked"
      }
     },
     "required": [
      "status"
     ]
    },
    "then": {
     "required": [
      "failure",
      "block_scope"
     ],
     "properties": {
      "failure": {},
      "block_scope": {}
     }
    }
   },
   {
    "if": {
     "properties": {
      "status": {
       "const": "blocked"
      },
      "failure": {
       "type": "object",
       "properties": {
        "code": {
         "const": "executor_unavailable"
        }
       },
       "required": [
        "code"
       ]
      }
     },
     "required": [
      "status",
      "failure"
     ]
    },
    "then": {
     "properties": {
      "failure": {
       "properties": {
        "kind": {
         "const": "internal"
        },
        "scope": {
         "const": "iteration"
        },
        "retryable": {
         "const": true
        }
       },
       "type": "object"
      },
      "block_scope": {
       "const": "iteration"
      }
     }
    }
   }
  ],
  "$defs": {
   "comparisonBase": {
    "type": "object",
    "properties": {
     "state_revision": {
      "type": "integer",
      "minimum": 0
     },
     "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
     },
     "artifact_identity": {
      "type": "string",
      "minLength": 1
     },
     "metric_median": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "required": [
     "state_revision",
     "artifact_sha256",
     "artifact_identity",
     "metric_median"
    ],
    "additionalProperties": false
   }
  }
 },
 "example": {
  "protocol_version": 2,
  "status": "candidate",
  "iteration": 0,
  "baseline_ref": {
   "contract_id": "topsop-v2-baseline-bundle",
   "result_path": "/tmp/run/characterize/result.json",
   "sha256": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
  },
  "candidate": {
   "candidate_id": "iter0-double-buffer",
   "base_artifact": {
    "path": "/tmp/.piano/state/topsop-v2/repo/example-op/workload/artifacts/rev-0/libkernel_example.so",
    "sha256": "sha256:6666666666666666666666666666666666666666666666666666666666666666",
    "identity": "baseline:aaaaaaaa"
   },
   "base_state_revision": 0,
   "mechanism": "overlap DTE load with compute",
