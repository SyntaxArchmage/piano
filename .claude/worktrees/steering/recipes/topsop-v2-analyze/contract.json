     "expected": "one private_dte context using no more than 11 virtual channels",
     "evidence_refs": [
      {
       "path": "/tmp/evidence/analysis.json",
       "sha256": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
      }
     ]
    }
   ],
   "falsification_criterion": "median latency does not improve beyond frozen threshold",
   "evidence_refs": [
    {
     "path": "/tmp/evidence/analysis.json",
     "sha256": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
    }
   ],
   "category": "data_movement_overlap",
   "comparison_base": {
    "state_revision": 0,
    "artifact_sha256": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    "artifact_identity": "baseline:example",
    "metric_median": 10.0
   }
  },
  "search_progress": {
   "target_experiments": 10,
   "measured_experiments": 0,
   "replan_generation": 0,
   "mode": "focused",
   "category_coverage": {
    "data_movement_overlap": "active",
    "tiling_partitioning": "untried",
    "storage_layout": "untried",
    "compute_codegen": "untried",
    "launch_specialization": "untried",
    "fusion_algorithm": "untried"
   },
   "evidence_refs": [
    {
     "path": "/tmp/evidence/search-progress.json",
     "sha256": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    }
   ]
  }
 },
 "outputs": {
  "metrics": [],
  "projections": [
   {
    "id": "workflow.status",
    "pointer": "/status",
    "format": "string",
    "required": true
   }
  ]
 }
}
