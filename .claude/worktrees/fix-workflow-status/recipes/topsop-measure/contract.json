{
  "version": 1,
  "id": "topsop-round-result",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "description": "Stage-specific topsop measure gate: one complete measured tuning-round result. Replaces the deprecated multi-mode topsop-optimize contract for measure stages.",
    "type": "object",
    "properties": {
      "iteration": {
        "type": "integer",
        "minimum": 0
      },
      "variable": {
        "type": "string",
        "minLength": 1
      },
      "variable_type": {
        "enum": [
          "structural",
          "config"
        ]
      },
      "hypothesis": {
        "type": "string",
        "minLength": 1
      },
      "decision": {
        "enum": [
          "KEEP",
          "DISCARD",
          "CONVERGED",
          "COMPILE_FAIL",
          "VERIFY_FAIL",
          "BLOCKED"
        ]
      },
      "candidate": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "current_best": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "verification": {
        "type": "object",
        "properties": {
          "compile_passed": {
            "type": "boolean"
          },
          "verify_passed": {
            "type": "boolean"
          },
          "report_path": {
            "type": "string",
            "minLength": 1
          },
          "diagnostics_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "compile_passed",
          "verify_passed"
        ],
        "additionalProperties": false
      },
      "profile": {
        "type": "object",
        "properties": {
          "kernel_latency_us": {
            "type": "number"
          },
          "llc_read_bandwidth_gbps": {
            "type": "number"
          },
          "llc_write_bandwidth_gbps": {
            "type": "number"
          },
          "llc_rw_sum_gbps": {
            "type": "number"
          },
          "sip_1d_efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "profile_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kernel_latency_us",
          "llc_rw_sum_gbps"
        ],
        "additionalProperties": false
      },
      "regression_pp": {
        "type": "number"
      },
      "asm_report": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "target_operator": {
            "type": "string"
          },
          "asm_source": {
            "type": "string",
            "minLength": 1
          },
          "assembly_bottleneck_points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "scheduling",
                    "bank_conflict",
                    "register_pressure",
                    "slot",
                    "pipeline_stall",
                    "other"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "description",
                "evidence",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "slot_utilization": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bank_conflict": {
            "type": "object",
            "properties": {
              "detected": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "detected"
            ],
            "additionalProperties": false
          },
          "register_pressure": {
            "type": "number",
            "minimum": 0
          },
          "estimated_cycles": {
            "type": "number",
            "minimum": 0
          },
          "analysis": {
            "type": "string"
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          },
          "blocker": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "target_operator"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "blocker"
              ],
              "properties": {
                "blocker": {}
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "ready"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "analysis"
                  ],
                  "properties": {
                    "analysis": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "assembly_bottleneck_points"
                  ],
                  "properties": {
                    "assembly_bottleneck_points": {}
                  }
                }
              ]
            }
          }
        ]
      },
      "promotion": {
        "type": "object",
        "properties": {
          "promoted": {
            "type": "boolean"
          },
          "resulting_best": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "promoted",
          "reason",
          "resulting_best"
        ],
        "additionalProperties": false
      },
      "next_variable": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "blocker": {
        "type": "string",
        "minLength": 1
      },
      "records": {
        "type": "object",
        "properties": {
          "round_path": {
            "type": "string",
            "minLength": 1
          },
          "state_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "round_path",
          "state_path"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "required": [
      "iteration",
      "variable",
      "hypothesis",
      "decision",
      "candidate",
      "current_best",
      "promotion",
      "next_variable",
      "records"
    ],
    "allOf": [
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "BLOCKED"
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "blocker"
          ],
          "properties": {
            "blocker": {}
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "not": {
                "const": "BLOCKED"
              }
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "verification"
          ],
          "properties": {
            "verification": {}
          }
        }
      },
      {
        "if": {
          "type": "object",
          "required": [
            "verification"
          ],
          "properties": {
            "verification": {
              "type": "object",
              "properties": {
                "compile_passed": {
                  "const": false
                }
              }
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "COMPILE_FAIL"
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "required": [
            "verification"
          ],
          "properties": {
            "verification": {
              "type": "object",
              "properties": {
                "compile_passed": {
                  "const": true
                },
                "verify_passed": {
                  "const": false
                }
              }
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "VERIFY_FAIL"
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "required": [
            "verification"
          ],
          "properties": {
            "decision": {
              "not": {
                "const": "BLOCKED"
              }
            },
            "verification": {
              "type": "object",
              "properties": {
                "compile_passed": {
                  "const": true
                },
                "verify_passed": {
                  "const": true
                }
              }
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "profile",
            "regression_pp"
          ],
          "properties": {
            "profile": {},
            "regression_pp": {}
          }
        }
      },
      {
        "if": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "decision": {
                  "const": "BLOCKED"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "verification"
              ],
              "properties": {
                "verification": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "compile_passed": {
                          "const": false
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "compile_passed": {
                          "const": true
                        },
                        "verify_passed": {
                          "const": false
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "profile": false,
            "asm_report": false,
            "regression_pp": false
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "KEEP"
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "promotion": {
              "type": "object",
              "properties": {
                "promoted": {
                  "const": true
                }
              }
            },
            "regression_pp": {
              "type": "number",
              "exclusiveMinimum": -1
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "not": {
                "const": "KEEP"
              }
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "promotion": {
              "type": "object",
              "properties": {
                "promoted": {
                  "const": false
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "DISCARD"
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "regression_pp": {
              "type": "number",
              "exclusiveMaximum": 5
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "decision": {
              "const": "CONVERGED"
            }
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "next_variable": {
              "type": "null"
            }
          }
        }
      }
    ]
  },
  "example": {
    "iteration": 1,
    "variable": "SUBTHREAD_NUM 2->1, kN=32",
    "variable_type": "config",
    "hypothesis": "64KB transfer recovers read bandwidth",
    "decision": "KEEP",
    "candidate": {
      "path": "topsop/lib/kernel/cc_kernel/normalize/sgl_add_add_rms_norm/gcu400/add_add_rms_norm_dte_load_impl.h"
    },
    "current_best": {
      "path": "topsop/lib/kernel/cc_kernel/normalize/sgl_add_add_rms_norm/gcu400/add_add_rms_norm_dte_load_impl.h"
    },
    "verification": {
      "compile_passed": true,
      "verify_passed": true,
      "report_path": "reports/verify.json"
    },
    "profile": {
      "kernel_latency_us": 186.05,
      "llc_read_bandwidth_gbps": 1104.56,
      "llc_write_bandwidth_gbps": 1085.41,
      "llc_rw_sum_gbps": 2189.97,
      "sip_1d_efficiency": 0.3275,
      "profile_path": "profiles/iter-001/kernel.json"
    },
    "regression_pp": 9.98,
    "promotion": {
      "promoted": true,
      "resulting_best": {
        "path": "topsop/lib/kernel/cc_kernel/normalize/sgl_add_add_rms_norm/gcu400/add_add_rms_norm_dte_load_impl.h"
      },
      "reason": "bandwidth utilization improved 9.98pp"
    },
    "next_variable": null,
    "records": {
      "round_path": "rounds/iter-001.json",
      "state_path": "state/tuning-state.json"
    }
  },
  "outputs": {
    "metrics": [],
    "projections": [
      {
        "id": "round.decision",
        "pointer": "/decision",
        "format": "string",
        "required": true
      },
      {
        "id": "round.hypothesis",
        "pointer": "/hypothesis",
        "format": "string",
        "required": true
      },
      {
        "id": "profile.kernel-latency-us",
        "pointer": "/profile/kernel_latency_us",
        "format": "number",
        "required": false
      },
      {
        "id": "profile.llc-rw-bandwidth-gbps",
        "pointer": "/profile/llc_rw_sum_gbps",
        "format": "number",
        "required": false
      },
      {
        "id": "round.regression-pp",
        "pointer": "/regression_pp",
        "format": "number",
        "required": false
      },
      {
        "id": "verification.passed",
        "pointer": "/verification/verify_passed",
        "format": "boolean",
        "required": false
      }
    ]
  }
}
