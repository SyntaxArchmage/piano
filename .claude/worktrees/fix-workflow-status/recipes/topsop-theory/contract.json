{
  "version": 1,
  "id": "topsop-theory-report",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "description": "Stage-specific topsop theory gate: baseline evidence and roofline ceiling. Replaces the deprecated multi-mode topsop-estimate contract for theory stages.",
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "ready",
          "timing-only",
          "blocked"
        ]
      },
      "target_operator": {
        "type": "string"
      },
      "shape": {
        "type": "string"
      },
      "baseline": {
        "type": "object",
        "properties": {
          "kernel_source": {
            "type": "string",
            "minLength": 1
          },
          "build": {
            "type": "object",
            "properties": {
              "so_path": {
                "type": "string",
                "minLength": 1
              },
              "so_mtime": {
                "type": "string"
              },
              "so_commit": {
                "type": "string"
              }
            },
            "required": [
              "so_path"
            ],
            "additionalProperties": false
          },
          "correctness": {
            "type": "object",
            "properties": {
              "target_case_passed": {
                "type": "boolean"
              },
              "full_regression_passed": {
                "type": "boolean"
              },
              "passed_count": {
                "type": "integer",
                "minimum": 0
              },
              "total_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "full_regression_passed",
              "target_case_passed"
            ],
            "additionalProperties": false
          },
          "profile": {
            "type": "object",
            "properties": {
              "kernel_latency_us": {
                "type": "number"
              },
              "llc_read_bandwidth_gbps": {
                "type": "number"
              },
              "llc_write_bandwidth_gbps": {
                "type": "number"
              },
              "llc_rw_sum_gbps": {
                "type": "number"
              },
              "llc_read_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "llc_write_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sip_1d_efficiency": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "vpd_bottleneck": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "build",
          "kernel_source"
        ],
        "additionalProperties": false
      },
      "theory": {
        "type": "object",
        "properties": {
          "read_write_balanced": {
            "type": "boolean"
          },
          "bandwidth_limit_gbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "theory_min_us": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bandwidth_utilization": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "bandwidth_limit_gbps",
          "bandwidth_utilization",
          "read_write_balanced",
          "theory_min_us"
        ],
        "additionalProperties": false
      },
      "blocker": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false,
    "required": [
      "target_operator"
    ],
    "allOf": [
      {
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "blocked"
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "blocker"
          ],
          "properties": {
            "blocker": {}
          }
        }
      },
      {
        "if": {
          "not": {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {}
                }
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "blocked",
                      "timing-only"
                    ]
                  }
                }
              }
            ]
          }
        },
        "then": {
          "type": "object",
          "required": [
            "baseline",
            "theory"
          ],
          "properties": {
            "baseline": {},
            "theory": {}
          }
        }
      }
    ],
    "x-piano-assertions": [
      {
        "path": "/theory/read_write_balanced",
        "message": "read_write_balanced must follow the LLC rule: RD/WR <= 3 and WR/RD <= 3",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "any",
              "args": [
                {
                  "op": "not",
                  "args": [
                    {
                      "op": "present",
                      "args": [
                        {
                          "path": "/status"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "path": "/status"
                    },
                    "ready"
                  ]
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/theory"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/baseline/profile/llc_read_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/baseline/profile/llc_write_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/baseline/profile/llc_read_bandwidth_gbps"
                },
                0
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/baseline/profile/llc_write_bandwidth_gbps"
                },
                0
              ]
            }
          ]
        },
        "test": {
          "op": "eq",
          "args": [
            {
              "path": "/theory/read_write_balanced"
            },
            {
              "op": "all",
              "args": [
                {
                  "op": "lte",
                  "args": [
                    {
                      "op": "divide",
                      "args": [
                        {
                          "path": "/baseline/profile/llc_read_bandwidth_gbps"
                        },
                        {
                          "path": "/baseline/profile/llc_write_bandwidth_gbps"
                        }
                      ]
                    },
                    3
                  ]
                },
                {
                  "op": "lte",
                  "args": [
                    {
                      "op": "divide",
                      "args": [
                        {
                          "path": "/baseline/profile/llc_write_bandwidth_gbps"
                        },
                        {
                          "path": "/baseline/profile/llc_read_bandwidth_gbps"
                        }
                      ]
                    },
                    3
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "path": "/theory/bandwidth_limit_gbps",
        "message": "bandwidth_limit_gbps must be 3000 for balanced LLC traffic and 2500 otherwise",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "any",
              "args": [
                {
                  "op": "not",
                  "args": [
                    {
                      "op": "present",
                      "args": [
                        {
                          "path": "/status"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "path": "/status"
                    },
                    "ready"
                  ]
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/theory"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/baseline/profile/llc_read_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/baseline/profile/llc_write_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/baseline/profile/llc_read_bandwidth_gbps"
                },
                0
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/baseline/profile/llc_write_bandwidth_gbps"
                },
                0
              ]
            }
          ]
        },
        "test": {
          "op": "eq",
          "args": [
            {
              "path": "/theory/bandwidth_limit_gbps"
            },
            {
              "op": "if",
              "args": [
                {
                  "op": "all",
                  "args": [
                    {
                      "op": "lte",
                      "args": [
                        {
                          "op": "divide",
                          "args": [
                            {
                              "path": "/baseline/profile/llc_read_bandwidth_gbps"
                            },
                            {
                              "path": "/baseline/profile/llc_write_bandwidth_gbps"
                            }
                          ]
                        },
                        3
                      ]
                    },
                    {
                      "op": "lte",
                      "args": [
                        {
                          "op": "divide",
                          "args": [
                            {
                              "path": "/baseline/profile/llc_write_bandwidth_gbps"
                            },
                            {
                              "path": "/baseline/profile/llc_read_bandwidth_gbps"
                            }
                          ]
                        },
                        3
                      ]
                    }
                  ]
                },
                3000,
                2500
              ]
            }
          ]
        }
      },
      {
        "path": "/theory/bandwidth_utilization",
        "message": "bandwidth_utilization must equal llc_rw_sum / bandwidth_limit within 0.02",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "all",
              "args": [
                {
                  "op": "any",
                  "args": [
                    {
                      "op": "not",
                      "args": [
                        {
