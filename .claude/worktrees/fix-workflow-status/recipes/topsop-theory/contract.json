                                      "args": [
                                        {
                                          "op": "divide",
                                          "args": [
                                            {
                                              "path": "/baseline/profile/llc_read_bandwidth_gbps"
                                            },
                                            {
                                              "path": "/baseline/profile/llc_write_bandwidth_gbps"
                                            }
                                          ]
                                        },
                                        3
                                      ]
                                    },
                                    {
                                      "op": "lte",
                                      "args": [
                                        {
                                          "op": "divide",
                                          "args": [
                                            {
                                              "path": "/baseline/profile/llc_write_bandwidth_gbps"
                                            },
                                            {
                                              "path": "/baseline/profile/llc_read_bandwidth_gbps"
                                            }
                                          ]
                                        },
                                        3
                                      ]
                                    }
                                  ]
                                },
                                3000,
                                2500
                              ]
                            }
                          ]
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            },
            0.02
          ]
        }
      },
