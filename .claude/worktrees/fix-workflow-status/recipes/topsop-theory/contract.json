        "when": {
          "op": "all",
          "args": [
            {
              "op": "all",
              "args": [
                {
                  "op": "any",
                  "args": [
                    {
                      "op": "not",
                      "args": [
                        {
                          "op": "present",
                          "args": [
                            {
                              "path": "/status"
                            }
                          ]
