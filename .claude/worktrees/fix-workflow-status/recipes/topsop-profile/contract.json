{
  "version": 1,
  "id": "topsop-profile-report",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "description": "Stage-specific topsop profile gate: per-round latency, LLC, efficiency, and bottleneck evidence. Replaces the deprecated multi-mode topsop-estimate contract for profile stages.",
    "type": "object",
    "properties": {
      "status": {
        "enum": [
          "ready",
          "timing-only",
          "blocked"
        ]
      },
      "target_operator": {
        "type": "string"
      },
      "shape": {
        "type": "string"
      },
      "device": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          }
        },
        "required": [
          "architecture",
          "name"
        ],
        "additionalProperties": false
      },
      "metrics": {
        "type": "object",
        "properties": {
          "kernel_latency_us": {
            "type": "number"
          },
          "llc_read_bandwidth_gbps": {
            "type": "number"
          },
          "llc_write_bandwidth_gbps": {
            "type": "number"
          },
          "llc_rw_sum_gbps": {
            "type": "number"
          },
          "sip_1d_efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sip_2d_efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "llc_read_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "llc_write_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "bandwidth_utilization": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "kernel_latency_us"
        ],
        "additionalProperties": false
      },
      "vpd": {
        "type": "object",
        "properties": {
          "duration_cycles": {
            "type": "integer",
            "minimum": 0
          },
          "bottleneck": {
            "enum": [
              "DTE_BOUND",
              "COMPUTE_BOUND",
              "UNKNOWN"
            ]
          },
          "diagnostic": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "self_consistency": {
        "type": "object",
        "properties": {
          "implied_bandwidth_gbps": {
            "type": "number"
          },
          "consistent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "bottlenecks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "compute",
                "memory",
                "occupancy",
                "launch"
              ]
            },
            "description": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "description",
            "evidence",
            "type"
          ],
          "additionalProperties": false
        }
      },
      "analysis": {
        "type": "string"
      },
      "raw_path": {
        "type": "string",
        "minLength": 1
      },
      "blocker": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false,
    "required": [
      "target_operator",
      "device",
      "metrics",
      "analysis"
    ],
    "allOf": [
      {
      "if": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "blocked"
            }
          }
        },
        "then": {
          "type": "object",
          "required": [
            "blocker"
          ],
          "properties": {
            "blocker": {}
          }
        }
      },
      {
        "if": {
          "not": {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {}
                }
              },
              {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "blocked",
                      "timing-only"
                    ]
                  }
                }
              }
            ]
          }
        },
        "then": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "object",
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "sip_1d_efficiency"
                  ],
                  "properties": {
                    "sip_1d_efficiency": {}
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "sip_2d_efficiency"
                  ],
                  "properties": {
                    "sip_2d_efficiency": {}
                  }
                }
              ],
              "required": [
                "llc_rw_sum_gbps"
              ],
              "properties": {
                "llc_rw_sum_gbps": {}
              }
            }
          }
        }
      }
    ],
    "x-piano-assertions": [
      {
        "path": "/metrics/bandwidth_utilization",
        "message": "bandwidth_utilization must equal llc_rw_sum / the LLC balance-rule limit within 0.02",
        "when": {
          "op": "all",
          "args": [
            {
              "op": "any",
              "args": [
                {
                  "op": "not",
                  "args": [
                    {
                      "op": "present",
                      "args": [
                        {
                          "path": "/status"
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    {
                      "path": "/status"
                    },
                    "ready"
                  ]
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/metrics/llc_read_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/metrics/llc_write_bandwidth_gbps"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/metrics/llc_rw_sum_gbps"
                }
              ]
            },
            {
              "op": "present",
              "args": [
                {
                  "path": "/metrics/bandwidth_utilization"
                }
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/metrics/llc_read_bandwidth_gbps"
                },
                0
              ]
            },
            {
              "op": "gt",
              "args": [
                {
                  "path": "/metrics/llc_write_bandwidth_gbps"
                },
                0
              ]
            }
          ]
        },
        "test": {
          "op": "lte",
          "args": [
            {
              "op": "abs",
              "args": [
                {
                  "op": "subtract",
                  "args": [
                    {
                      "path": "/metrics/bandwidth_utilization"
                    },
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "divide",
                          "args": [
                            {
                              "path": "/metrics/llc_rw_sum_gbps"
                            },
                            {
                              "op": "if",
                              "args": [
                                {
                                  "op": "all",
                                  "args": [
                                    {
                                      "op": "lte",
                                      "args": [
                                        {
                                          "op": "divide",
                                          "args": [
                                            {
                                              "path": "/metrics/llc_read_bandwidth_gbps"
                                            },
                                            {
                                              "path": "/metrics/llc_write_bandwidth_gbps"
                                            }
                                          ]
                                        },
                                        3
                                      ]
                                    },
                                    {
                                      "op": "lte",
                                      "args": [
                                        {
                                          "op": "divide",
                                          "args": [
                                            {
                                              "path": "/metrics/llc_write_bandwidth_gbps"
                                            },
                                            {
                                              "path": "/metrics/llc_read_bandwidth_gbps"
                                            }
                                          ]
                                        },
                                        3
                                      ]
                                    }
                                  ]
                                },
                                3000,
                                2500
                              ]
                            }
                          ]
                        },
                        1
                      ]
                    }
                  ]
                }
              ]
            },
            0.02
          ]
        }
      }
    ]
  },
  "example": {
    "status": "ready",
    "target_operator": "topssglAddAddRmsNorm",
    "shape": "[16384,2048]",
    "device": {
      "name": "Enflame L600 DEV0",
      "architecture": "GCU400"
    },
    "metrics": {
      "kernel_latency_us": 186.05,
      "llc_read_bandwidth_gbps": 1104.56,
      "llc_write_bandwidth_gbps": 1085.41,
      "llc_rw_sum_gbps": 2189.97,
      "sip_1d_efficiency": 0.3275,
      "bandwidth_utilization": 0.73
    },
    "vpd": {
      "duration_cycles": 215433,
      "bottleneck": "DTE_BOUND",
      "diagnostic": "wait-for-mailbox dominates"
    },
    "self_consistency": {
      "implied_bandwidth_gbps": 2183,
      "consistent": true
    },
    "bottlenecks": [
      {
        "type": "memory",
        "description": "LLC bandwidth bound",
        "evidence": "bytes / latency ~ measured"
      }
    ],
    "analysis": "read path ~1.1 TB/s + write path ~1.08 TB/s is the practical ceiling",
    "raw_path": "profiles/iter-000/kernel.json"
  },
  "outputs": {
    "metrics": [],
    "projections": [
      { "id": "workflow.status", "pointer": "/status", "format": "string", "required": false },
      { "id": "profile.kernel-latency-us", "pointer": "/metrics/kernel_latency_us", "format": "number", "required": false },
      { "id": "profile.llc-rw-bandwidth-gbps", "pointer": "/metrics/llc_rw_sum_gbps", "format": "number", "required": false }
    ]
  }
}
