{
  "version": 1,
  "id": "optimization-proposal",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "type": "object",
    "required": ["strategies"],
    "properties": {
      "strategies": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "bottleneck", "technique", "rationale", "predicted_speedup", "risk_level"],
          "properties": {
            "id": { "type": "string" },
            "bottleneck": { "type": "string" },
            "technique": { "type": "string" },
            "rationale": { "type": "string" },
            "predicted_speedup": { "type": "number", "exclusiveMinimum": 0 },
            "risk_level": { "enum": ["low", "medium", "high"] },
            "conflicts_with": { "type": "array", "items": { "type": "string" } },
            "falsification_criterion": { "type": "string" },
            "mechanism_over_config": { "type": "boolean" },
            "variable_type": { "enum": ["structural", "config"] }
          },
          "additionalProperties": false
        }
      },
      "already_optimal": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string" } },
        "additionalProperties": false
      },
      "history_considered": { "type": "array", "items": { "type": "string" } },
      "research_queries": { "type": "array", "items": { "type": "string" } },
      "rechecked_premises": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["premise", "invalidated", "evidence"],
          "properties": {
            "premise": { "type": "string", "minLength": 1 },
            "invalidated": { "type": "boolean" },
            "evidence": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false,
    "allOf": [{
      "if": {
        "type": "object",
        "properties": {
          "strategies": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["variable_type"],
              "properties": { "variable_type": { "const": "structural" } }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["rechecked_premises"],
        "properties": { "rechecked_premises": { "type": "array", "minItems": 1 } }
      }
    }]
  },
  "example": {
    "strategies": [
      {
        "id": "candidate-id",
        "bottleneck": "memory",
        "technique": "specific change",
        "rationale": "why this should help",
        "predicted_speedup": 1.1,
        "risk_level": "low"
      }
    ]
  },
  "outputs": {
    "metrics": [],
    "projections": [
      { "id": "workflow.map-items", "pointer": "/strategies", "format": "json", "required": true }
    ]
  }
}
