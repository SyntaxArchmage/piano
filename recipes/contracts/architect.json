{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "decision_summary": { "type": "string", "minLength": 1 },
      "known_facts": { "type": "array", "items": { "type": "string" } },
      "assumptions": { "type": "array", "items": { "type": "string" } },
      "current_state": { "type": "string", "minLength": 1 },
      "proposed_architecture": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "components": { "type": "array", "items": { "type": "string" } },
          "boundaries": { "type": "array", "items": { "type": "string" } },
          "interfaces": { "type": "array", "items": { "type": "string" } },
          "data_flow": { "type": "array", "items": { "type": "string" } },
          "failure_modes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["components", "boundaries", "interfaces", "data_flow", "failure_modes"]
      },
      "alternatives": { "type": "array", "items": { "type": "string" } },
      "implementation_plan": { "type": "array", "items": { "type": "string" } },
      "validation_gates": { "type": "array", "items": { "type": "string" } },
      "risks": { "type": "array", "items": { "type": "string" } },
      "open_questions": { "type": "array", "items": { "type": "string" } },
      "supervisor_decision_required": { "type": "string", "minLength": 1 },
      "quality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
          "fine_grainedness": { "type": "number", "minimum": 0, "maximum": 1 },
          "prettiness": { "type": "number", "minimum": 0, "maximum": 1 },
          "elegance": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["completeness", "fine_grainedness", "prettiness", "elegance", "evidence"]
      }
    },
    "required": [
      "decision_summary",
      "known_facts",
      "assumptions",
      "current_state",
      "proposed_architecture",
      "alternatives",
      "implementation_plan",
      "validation_gates",
      "risks",
      "open_questions",
      "supervisor_decision_required"
    ]
  },
  "example": {
    "decision_summary": "Prefer a small adapter boundary so the existing API remains stable.",
    "known_facts": ["The current service owns persistence."],
    "assumptions": ["A backward-compatible migration is required."],
    "current_state": "The request path directly calls the persistence implementation.",
    "proposed_architecture": {
      "components": ["Request adapter", "Application service", "Persistence port"],
      "boundaries": ["The application service depends on a persistence port, not a database client."],
      "interfaces": ["PersistencePort.save(command): Result"],
      "data_flow": ["Request -> adapter -> service -> port -> implementation"],
      "failure_modes": ["Persistence timeout returns a typed error and emits a structured event."]
    },
    "alternatives": ["Keep the direct call: lower short-term cost, higher coupling."],
    "implementation_plan": ["Approve the boundary", "Add focused contract tests", "Migrate callers incrementally"],
    "validation_gates": ["Typecheck", "Focused tests", "Review compatibility and rollback"],
    "risks": ["The port may be too broad if it mirrors the database client."],
    "open_questions": ["What is the required rollback window?"],
    "supervisor_decision_required": "Approve the adapter boundary and confirm the rollback window.",
    "quality": {
      "completeness": 1,
      "fine_grainedness": 1,
      "prettiness": 1,
      "elegance": 1,
      "evidence": ["All interfaces and validation gates are listed."]
    }
  },
  "outputs": {
    "metrics": [],
    "projections": [
      { "id": "workflow.map-items", "pointer": "/implementation_plan", "format": "json", "required": true }
    ]
  }
}
