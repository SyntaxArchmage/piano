{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["iteration", "decision", "candidate", "current_best", "verification", "promotion", "records"],
    "properties": {
      "iteration": { "type": "integer", "minimum": 0 },
      "decision": { "enum": ["KEEP", "DISCARD", "COMPILE_FAIL", "VERIFY_FAIL", "BLOCKED"] },
      "demoted_from_keep": { "const": true },
      "candidate": { "$ref": "#/$defs/artifactRef" },
      "current_best": { "$ref": "#/$defs/artifactRef" },
      "verification": {
        "type": "object",
        "required": ["compile_passed", "verify_passed"],
        "properties": {
          "compile_passed": { "type": "boolean" },
          "verify_passed": { "type": "boolean" },
          "report_path": { "type": "string", "minLength": 1 },
          "diagnostics_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "benchmark": { "$ref": "#/$defs/benchmark" },
      "promotion": {
        "type": "object",
        "required": ["promoted", "resulting_best", "reason"],
        "properties": {
          "promoted": { "type": "boolean" },
          "resulting_best": { "$ref": "#/$defs/artifactRef" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "records": {
        "type": "object",
        "required": ["round_path", "state_path"],
        "properties": {
          "round_path": { "type": "string", "minLength": 1 },
          "state_path": { "type": "string", "minLength": 1 },
          "profile_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "$defs": {
      "artifactRef": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "benchmark": {
        "type": "object",
        "required": ["name", "unit", "direction", "samples", "best", "median", "runs", "warmup"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["higher", "lower"] },
          "samples": { "type": "array", "minItems": 1, "items": { "type": "number" } },
          "best": { "type": "number" },
          "median": { "type": "number" },
          "runs": { "type": "integer", "minimum": 1 },
          "warmup": { "type": "integer", "minimum": 0 },
          "raw_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "allOf": [
      {
        "if": {
          "type": "object",
          "properties": { "verification": { "type": "object", "properties": { "compile_passed": { "const": false } }, "required": ["compile_passed"] } },
          "required": ["verification"]
        },
        "then": {
          "type": "object",
          "properties": { "decision": { "const": "COMPILE_FAIL" }, "promotion": { "type": "object", "properties": { "promoted": { "const": false } } } },
          "not": { "type": "object", "properties": { "benchmark": {} }, "required": ["benchmark"] }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "verification": {
              "type": "object",
              "properties": { "compile_passed": { "const": true }, "verify_passed": { "const": false } },
              "required": ["compile_passed", "verify_passed"]
            }
          },
          "required": ["verification"]
        },
        "then": {
          "type": "object",
          "properties": { "decision": { "const": "VERIFY_FAIL" }, "promotion": { "type": "object", "properties": { "promoted": { "const": false } } } },
          "not": { "type": "object", "properties": { "benchmark": {} }, "required": ["benchmark"] }
        }
      },
      {
        "if": {
          "type": "object",
          "properties": {
            "verification": {
              "type": "object",
              "properties": { "compile_passed": { "const": true }, "verify_passed": { "const": true } },
              "required": ["compile_passed", "verify_passed"]
            }
          },
          "required": ["verification"]
        },
        "then": {
          "type": "object",
          "properties": { "decision": { "enum": ["KEEP", "DISCARD", "BLOCKED"] } }
        }
      },
      {
        "if": { "type": "object", "properties": { "decision": { "enum": ["KEEP", "DISCARD"] } }, "required": ["decision"] },
        "then": {
          "type": "object",
          "required": ["benchmark"],
          "properties": {
            "benchmark": {},
            "verification": { "type": "object", "properties": { "compile_passed": { "const": true }, "verify_passed": { "const": true } } }
          }
        }
      },
      {
        "if": { "type": "object", "properties": { "decision": { "const": "KEEP" } }, "required": ["decision"] },
        "then": { "type": "object", "properties": { "promotion": { "type": "object", "properties": { "promoted": { "const": true } } } } },
        "else": { "type": "object", "properties": { "promotion": { "type": "object", "properties": { "promoted": { "const": false } } } } }
      },
      {
        "if": { "type": "object", "properties": { "decision": { "const": "BLOCKED" } }, "required": ["decision"] },
        "then": { "not": { "type": "object", "properties": { "benchmark": {} }, "required": ["benchmark"] } }
      }
    ],
    "additionalProperties": false
  },
  "example": {
    "iteration": 0,
    "decision": "KEEP",
    "candidate": { "path": "candidates/iter-000.cu", "digest": "sha256:example" },
    "current_best": { "path": "state/current-best.cu", "digest": "sha256:example" },
    "verification": { "compile_passed": true, "verify_passed": true, "report_path": "reports/verify.json" },
    "benchmark": {
      "name": "tflops",
      "unit": "TFLOP/s",
      "direction": "higher",
      "samples": [10, 11],
      "best": 11,
      "median": 10.5,
      "runs": 2,
      "warmup": 1,
      "raw_path": "bench/iter-000.txt"
    },
    "promotion": {
      "promoted": true,
      "resulting_best": { "path": "state/current-best.cu", "digest": "sha256:example" },
      "reason": "candidate improved best"
    },
    "records": { "round_path": "rounds/iter-000.json", "state_path": "state/tuning-state.json" }
  },
  "outputs": {
    "metrics": [
      { "pointer": "/benchmark", "format": "benchmark/v1", "required": false }
    ],
    "projections": [
      {
        "id": "round.materialization-v1",
        "pointer": "",
        "format": "json",
        "required": true
      },
      {
        "id": "round.iteration",
        "pointer": "/iteration",
        "format": "number",
        "required": true
      },
      {
        "id": "round.decision",
        "pointer": "/decision",
        "format": "string",
        "required": true
      },
      {
        "id": "round.candidate",
        "pointer": "/candidate",
        "format": "json",
        "required": true
      },
      {
        "id": "round.current-best",
        "pointer": "/current_best",
        "format": "json",
        "required": true
      },
      {
        "id": "round.verification",
        "pointer": "/verification",
        "format": "json",
        "required": true
      },
      {
        "id": "round.promotion",
        "pointer": "/promotion",
        "format": "json",
        "required": true
      },
      {
        "id": "round.records",
        "pointer": "/records",
        "format": "json",
        "required": true
      },
      {
        "id": "verification.passed",
        "pointer": "/verification/verify_passed",
        "format": "boolean",
        "required": true
      },
      {
        "id": "benchmark.evidence",
        "pointer": "/benchmark",
        "format": "json",
        "required": false
      }
    ]
  }
}
