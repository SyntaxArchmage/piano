{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["demo_stage", "purpose", "primitive", "action", "observation", "next"],
    "properties": {
      "demo_stage": { "type": "string", "minLength": 1 },
      "purpose": { "type": "string", "minLength": 1 },
      "primitive": { "type": "string", "minLength": 1 },
      "action": { "type": "string", "minLength": 1 },
      "observation": { "type": "string", "minLength": 1 },
      "next": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "example": {
    "demo_stage": "inspect",
    "purpose": "show downstream accepted-input consumption",
    "primitive": "from + automatic inputs",
    "action": "read inputs.json",
    "observation": "the upstream result was available",
    "next": "make-items"
  }
}
