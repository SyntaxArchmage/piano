{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "x-piano-unknown-properties": "strip",
    "type": "object",
    "required": ["target_operator", "device", "analysis"],
    "properties": {
      "status": { "enum": ["ready", "timing-only", "blocked"] },
      "target_operator": { "type": "string" },
      "device": {
        "type": "object",
        "required": ["name", "architecture"],
        "properties": {
          "name": { "type": "string" },
          "architecture": { "type": "string" }
        },
        "additionalProperties": false
      },
      "metrics": {
        "type": "object",
        "properties": {
          "compute_utilization": { "type": "number", "minimum": 0, "maximum": 1 },
          "memory_bandwidth_utilization": { "type": "number", "minimum": 0, "maximum": 1 },
          "achieved_occupancy": { "type": "number", "minimum": 0, "maximum": 1 },
          "launch_overhead": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "bottlenecks": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["type", "description", "evidence"],
          "properties": {
            "type": { "enum": ["compute", "memory", "occupancy", "launch"] },
            "description": { "type": "string" },
            "evidence": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "analysis": { "type": "string" },
      "raw_path": { "type": "string", "minLength": 1 },
      "blocker": { "type": "string", "minLength": 1 }
    },
    "allOf": [
      {
        "if": { "type": "object", "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
        "then": { "type": "object", "properties": { "blocker": {} }, "required": ["blocker"] },
        "else": { "type": "object", "properties": { "metrics": {}, "bottlenecks": {} }, "required": ["metrics", "bottlenecks"] }
      },
      {
        "if": {
          "anyOf": [
            { "type": "object", "properties": { "status": { "const": "ready" } }, "required": ["status"] },
            { "not": { "type": "object", "properties": { "status": {} }, "required": ["status"] } }
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "object",
              "properties": {
                "compute_utilization": {},
                "memory_bandwidth_utilization": {},
                "achieved_occupancy": {},
                "launch_overhead": {}
              },
              "required": ["compute_utilization", "memory_bandwidth_utilization", "achieved_occupancy", "launch_overhead"]
            },
            "bottlenecks": {}
          },
          "required": ["metrics", "bottlenecks"]
        }
      }
    ],
    "additionalProperties": false
  },
  "example": {
    "status": "timing-only",
    "target_operator": "kernel:run",
    "device": { "name": "GPU name", "architecture": "architecture" },
    "metrics": { "memory_bandwidth_utilization": 0.5, "launch_overhead": 1.2 },
    "bottlenecks": [
      { "type": "memory", "description": "what limits throughput", "evidence": "measured evidence" }
    ],
    "analysis": "short analysis"
  },
  "outputs": {
    "metrics": [],
    "projections": [
      { "id": "workflow.status", "pointer": "/status", "format": "string", "required": false }
    ]
  }
}
