{
  "version": 1,
  "id": "coding-review",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["verdict", "findings", "advice"],
    "properties": {
      "verdict": { "enum": ["approve", "changes_requested", "blocked"] },
      "findings": { "type": "array", "items": { "type": "string" } },
      "advice": { "type": "array", "items": { "type": "string" } },
      "advice_text": { "type": "string" }
    },
    "additionalProperties": false
  },
  "example": { "verdict": "approve", "findings": [], "advice": [], "advice_text": "No changes requested." }
}
